# Sonic mainnet build. Copy to .env.mainnet after deploying the router (script/DeployMainnet.s.sol).
# Once .env.mainnet exists, deploy/push.sh builds and serves this app next to the testnet one.
NEXT_PUBLIC_CHAIN_ID=146
NEXT_PUBLIC_RPC_URL=https://rpc.soniclabs.com
NEXT_PUBLIC_EXPLORER_URL=https://sonicscan.org

# required: the address printed by script/DeployMainnet.s.sol
NEXT_PUBLIC_ROUTER_ADDRESS=

# leave empty on mainnet unless the home page should offer a real-money example tip
NEXT_PUBLIC_SAMPLE_RECIPIENT=

NEXT_PUBLIC_USSD_ADDRESS=0x000000000eCcFf26B795F73fb0A70d48da657fEf
NEXT_PUBLIC_USDC_ADDRESS=0x29219dd400f2Bf60E5a23d13Be72B486D4038894

# must stay empty on mainnet
NEXT_PUBLIC_TEST_TOKENS=

NEXT_PUBLIC_WC_PROJECT_ID=

NEXT_PUBLIC_SITE_URL=https://cync.avenor-protocol.com
MAINNET_DOMAIN=cync.avenor-protocol.com
