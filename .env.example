NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# leave empty to send tips directly
NEXT_PUBLIC_ROUTER_ADDRESS=

NEXT_PUBLIC_SAMPLE_RECIPIENT=

# ERC-20s to offer (empty = native S only); USSD becomes the default when set
NEXT_PUBLIC_USSD_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
# 1 = the tokens above are testnet TestTokens: shows the /faucet page
NEXT_PUBLIC_TEST_TOKENS=

NEXT_PUBLIC_WC_PROJECT_ID=

# public URL of the site, for link-preview images (empty = the Vercel deployment URL)
NEXT_PUBLIC_SITE_URL=

# self-hosting only (docker-compose.yml): the bare domain Caddy serves, e.g. example.io
# NEXT_PUBLIC_SITE_URL must then be https://<DOMAIN>
DOMAIN=
